<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<!-- 本機只裝了 .NET 10 執行階段，允許在更新的 runtime 上滾動執行 -->
		<RollForward>LatestMajor</RollForward>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<AssemblyName>sqlcheck</AssemblyName>
		<RootNamespace>SqlCheck</RootNamespace>
		<EnableDefaultNoneItems>false</EnableDefaultNoneItems>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.SqlServer.DacFx" Version="170.2.70" />
		<PackageReference Include="Microsoft.SqlServer.TransactSql.ScriptDom" Version="170.191.0" />
		<None Include="compat2014.txt" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>
</Project>
